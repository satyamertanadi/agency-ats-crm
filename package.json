{
  "name": "agency-ats-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json && node node_modules/vite/bin/vite.js build",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.app.json --pretty false && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json --pretty false",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/styles/**/*.css\"",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "test": "node node_modules/vitest/vitest.mjs run --maxWorkers=1",
    "test:functions": "node scripts/smoke-edge-functions.mjs",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "test:rls": "node node_modules/vitest/vitest.mjs run --config vitest.rls.config.ts",
    "test:staging": "node node_modules/vitest/vitest.mjs run --config vitest.staging.config.ts",
    "demo:generate": "node scripts/generate-demo-data.mjs",
    "format:css": "prettier --write \"src/styles/**/*.css\"",
    "format:css:check": "prettier --check \"src/styles/**/*.css\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.101.2",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "lucide-react": "^0.564.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.72.0",
    "react-router": "^8.3.0",
    "read-excel-file": "^9.3.1",
    "recharts": "^3.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "jszip": "3.10.1",
    "prettier": "^3.9.5",
    "stylelint": "^16.26.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
