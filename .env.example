VITE_PRODUCT_NAME=Agency ATS CRM
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Local development only. Ignored by production builds regardless of value (see src/shared/lib/env.ts).
VITE_ALLOW_PASSWORD_AUTH=true
VITE_ALLOW_SELF_SERVICE_ONBOARDING=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_ENABLE_SENTRY_REPLAY=false
APP_ORIGIN=http://127.0.0.1:5173
ENVIRONMENT=development
EMAIL_FROM="Agency ATS <onboarding@resend.dev>"
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:55321/functions/v1/calendar-auth-callback
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Both optional. Set only while actively rotating CALENDAR_TOKEN_ENCRYPTION_KEY -- see "Rotating the
# Calendar token encryption key" in docs/runbooks.md. Leave unset otherwise.
CALENDAR_TOKEN_ENCRYPTION_KEY_VERSION=
CALENDAR_TOKEN_ENCRYPTION_KEY_PREVIOUS=
CALENDAR_TOKEN_ENCRYPTION_KEY_PREVIOUS_VERSION=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
# Optional: cheaper model for the mechanical CV/LinkedIn parsers (structured extraction).
# Falls back to AI_MODEL when unset. Evaluation (generate-candidate-profile) always uses AI_MODEL.
AI_MODEL_PARSE=claude-haiku-4-5
WORKER_SECRET=
